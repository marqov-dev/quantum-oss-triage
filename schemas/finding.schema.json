{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marqov-dev/quantum-oss-triage/schemas/finding.schema.json",
  "title": "Finding record",
  "description": "One merged finding as stored in a run record. Evidence is kept in separate fields: where it came from (detection), who agreed (corroboration), how it was checked (validation), what it affects (impact), how bad (severity), who may see it (sensitivity), and what a person decided (disposition). Models agreeing is not validation; severity is set by a person; severity never decides sensitivity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "repo",
    "commit",
    "title",
    "area",
    "category",
    "file",
    "line_start",
    "line_end",
    "fingerprint",
    "claim",
    "evidence",
    "why_it_matters",
    "detection",
    "corroboration",
    "validation",
    "impact",
    "severity",
    "sensitivity",
    "disposition"
  ],
  "$defs": {
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tool",
        "skill",
        "unit",
        "title"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "model",
            "scanner",
            "prior_work"
          ]
        },
        "tool": {
          "type": "string",
          "description": "Adapter name (claude, codex, antigravity) or scanner name."
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "description": "Ledger key of the unit that produced it."
        },
        "title": {
          "type": "string",
          "description": "The detector's original title, kept verbatim."
        },
        "line_start": {
          "type": "integer"
        },
        "line_end": {
          "type": "integer"
        },
        "proposed_severity": {
          "$ref": "#/$defs/severity"
        },
        "security_impact": {
          "type": "boolean"
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "verdict",
        "reason",
        "independence",
        "unit"
      ],
      "properties": {
        "verifier": {
          "type": "string"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "confirm",
            "refute",
            "unsure",
            "pending",
            "failed"
          ]
        },
        "reason": {
          "type": "string"
        },
        "lines_read": {
          "type": "array"
        },
        "independence": {
          "type": "string",
          "enum": [
            "independent",
            "same_model"
          ],
          "description": "same_model: the detecting model rechecked in a fresh context because no other model was available. Recorded, but it never counts toward the main queue."
        },
        "security_impact": {
          "type": "boolean"
        },
        "proposed_severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/severity"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^QOT-[0-9a-f]{10}$",
      "description": "Stable ID derived from repo and fingerprint. Branch names use it and nothing else."
    },
    "repo": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": [
        "security",
        "correctness",
        "docs",
        "tests",
        "maintenance",
        "quantum"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "security_vulnerability",
        "dependency_advisory",
        "correctness",
        "docs_tests_maintenance"
      ],
      "description": "The report scorecard bucket. Known dependency advisories are counted apart from newly found vulnerabilities."
    },
    "file": {
      "type": "string"
    },
    "line_start": {
      "type": "integer"
    },
    "line_end": {
      "type": "integer"
    },
    "fingerprint": {
      "type": "string",
      "description": "area + path + normalised snippet hash. Helps match on a rerun; a changed fingerprint does not prove a fix."
    },
    "claim": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "applies_because": {
      "type": [
        "string",
        "null"
      ]
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detections",
        "detected_by"
      ],
      "properties": {
        "detections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/detection"
          }
        },
        "detected_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Distinct tools that raised it on their own in stage 2 or 3."
        }
      }
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_models",
        "verifications",
        "status"
      ],
      "properties": {
        "independent_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Distinct models that found it independently in stage 3. Two or more counts as independent discovery."
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verification"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "single_source",
            "independent_discovery",
            "confirmed",
            "refuted",
            "disputed",
            "unsure",
            "pending"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unvalidated",
            "reproduced",
            "not_reproduced",
            "inspection",
            "blocked",
            "pending"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "reproduction",
            "test",
            "technical_inspection",
            null
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path in the private evidence store."
        },
        "notes": {
          "type": "string"
        },
        "reproduction": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "security_impact"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "security_impact": {
          "type": "boolean"
        },
        "affected_behaviours": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed",
        "final",
        "set_by"
      ],
      "properties": {
        "proposed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "by",
              "value"
            ],
            "properties": {
              "by": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/severity"
              }
            }
          }
        },
        "final": {
          "anyOf": [
            {
              "$ref": "#/$defs/severity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set by a person at triage. Null until then."
        },
        "set_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitive",
        "reasons",
        "removal_reason"
      ],
      "properties": {
        "sensitive": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removal_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required when a person clears the flag."
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue",
        "decision",
        "decided_by",
        "decided_at",
        "note"
      ],
      "properties": {
        "queue": {
          "type": "string",
          "enum": [
            "main",
            "low"
          ]
        },
        "queue_reason": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "accept",
            "reject",
            "duplicate",
            "defer",
            "investigate"
          ]
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fix": {
      "type": [
        "object",
        "null"
      ]
    },
    "prior_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "upstream"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "found",
              "reported",
              "fixed",
              "rejected"
            ]
          },
          "upstream": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
